export FIVEONEONE_API_KEY_1=example
export FIVEONEONE_API_KEY_2=example2
export CALTRAIN_GATEWAY_SECRET=supersecretvalue

# Optional: PostgreSQL connection string. Without it the app runs without a
# database and departure tracking is disabled.
# export DATABASE_URL=postgres://user:pass@localhost:5432/caltrain?sslmode=disable

# Optional: record observed departure times. Defaults to true when a database
# is configured. The interval has a 1m floor because 511 allows only 60
# requests per hour per API key across all endpoints.
# export DEPARTURE_TRACKING_ENABLED=true
# export DEPARTURE_POLL_INTERVAL=2m
